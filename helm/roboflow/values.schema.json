{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Roboflow Helm Chart Values",
  "description": "Values schema for the roboflow Helm chart",
  "type": "object",
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "imageRegistry": {"type": "string"},
        "commonAnnotations": {"type": "object"},
        "commonLabels": {"type": "object"}
      }
    },
    "image": {
      "type": "object",
      "properties": {
        "registry": {"type": "string"},
        "repository": {"type": "string"},
        "tag": {"type": "string"},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]},
        "pullSecrets": {"type": "array"}
      },
      "required": ["repository", "tag"]
    },
    "worker": {
      "type": "object",
      "properties": {
        "replicas": {"type": "integer", "minimum": 0},
        "podAnnotations": {"type": "object"},
        "podLabels": {"type": "object"},
        "resources": {"type": "object"},
        "nodeSelector": {"type": "object"},
        "tolerations": {"type": "array"},
        "affinity": {"type": "object"},
        "command": {"type": "array"},
        "args": {"type": "array"},
        "env": {"type": "array"},
        "envFrom": {"type": "array"},
        "serviceAccount": {"type": "object"},
        "rbac": {"type": "object"}
      }
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "minReplicas": {"type": "integer", "minimum": 0},
        "maxReplicas": {"type": "integer", "minimum": 0},
        "targetCPUUtilizationPercentage": {"type": "integer", "minimum": 0, "maximum": 100},
        "targetMemoryUtilizationPercentage": {"type": "integer", "minimum": 0, "maximum": 100}
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "minAvailable": {"type": "integer"},
        "maxUnavailable": {"type": "integer"}
      }
    },
    "serviceMonitor": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "interval": {"type": "string"},
        "scrapeTimeout": {"type": "string"}
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "logLevel": {"type": "string"},
        "tikv": {"type": "object"},
        "storage": {"type": "object"},
        "pipeline": {"type": "object"},
        "dataset": {"type": "object"},
        "features": {"type": "object"}
      }
    },
    "secrets": {
      "type": "object",
      "properties": {
        "create": {"type": "boolean"},
        "oss": {"type": "object"},
        "s3": {"type": "object"},
        "existingSecrets": {"type": "object"}
      }
    },
    "job": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "backoffLimit": {"type": "integer", "minimum": 0},
        "activeDeadlineSeconds": {"type": "integer", "minimum": 0},
        "command": {"type": "array"},
        "args": {"type": "array"}
      }
    },
    "redis": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"}
      }
    },
    "minio": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"}
      }
    },
    "tikv": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"}
      }
    }
  }
}
